<mujoco model="universa_finger">
  <compiler angle="radian" autolimits="true" meshdir="../assets"/>
  <option gravity="0 0 -9.81" timestep="0.001" integrator="implicitfast" solver="Newton"
          cone="elliptic" impratio="10" iterations="100" tolerance="1e-10"/>

  <extension>
    <plugin plugin="tip.tactile.universa"/>
  </extension>

  <custom>
    <text name="universa_soft" data="finger_silicone"/>
    <text name="universa_rigid" data="probe_geom"/>
  </custom>

  <default>
    <default class="probe_contact">
      <geom mass="0.001" material="box_mat" contype="3" conaffinity="3"
            friction="1 0.05 0.05" solref="0.002 1" solimp="0.99 0.999 0.0005"/>
      <default class="probe_sphere">
        <geom type="sphere" size="0.005"/>
      </default>
      <default class="probe_cuboid">
        <geom type="box" size="0.006 0.009 0.004" pos="0 0 -0.001"/>
      </default>
      <default class="probe_cube">
        <geom type="box" size="0.005 0.005 0.005"/>
      </default>
      <default class="probe_nut">
        <geom type="mesh" pos="0.039 -0.102 -0.0215" mass="0.0000666666666667" material="metal"
              contype="1" conaffinity="2"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="factory_floor_mat" rgba="0.35 0.36 0.38 1" reflectance="0.10" specular="0.3" shininess="0.2"/>
    <material name="metal" rgba="0.58 0.58 0.58 1"/>
    <material name="silicone_vis" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="box_mat" rgba="0.75 0.35 0.15 1"/>

    <mesh name="gripper_end"   file="univesa_gripper/Finger.stl"        scale="0.001 0.001 0.001"/>
    <mesh name="silicone"      file="univesa_gripper/silicone.stl"      scale="0.001 0.001 0.001"/>
    <mesh name="silicone_hull" file="univesa_gripper/silicone_hull.stl" scale="0.001 0.001 0.002"/>

    <mesh name="probe_nut_hull0" file="screw_nut/M3_HEX_NUT_hull0.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull1" file="screw_nut/M3_HEX_NUT_hull1.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull2" file="screw_nut/M3_HEX_NUT_hull2.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull3" file="screw_nut/M3_HEX_NUT_hull3.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull4" file="screw_nut/M3_HEX_NUT_hull4.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull5" file="screw_nut/M3_HEX_NUT_hull5.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull6" file="screw_nut/M3_HEX_NUT_hull6.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull7" file="screw_nut/M3_HEX_NUT_hull7.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull8" file="screw_nut/M3_HEX_NUT_hull8.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull9" file="screw_nut/M3_HEX_NUT_hull9.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull10" file="screw_nut/M3_HEX_NUT_hull10.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull11" file="screw_nut/M3_HEX_NUT_hull11.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull12" file="screw_nut/M3_HEX_NUT_hull12.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull13" file="screw_nut/M3_HEX_NUT_hull13.stl" scale="0.003 0.003 0.003"/>
    <mesh name="probe_nut_hull14" file="screw_nut/M3_HEX_NUT_hull14.stl" scale="0.003 0.003 0.003"/>
  </asset>

  <worldbody>
    <light diffuse="1 1 1" pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <light diffuse="0.5 0.5 0.5" pos="1.5 0 1.5" dir="-1 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="factory_floor_mat" contype="1" conaffinity="1"/>
    <body name="probe" pos="0.035386 0.015 0.024063" gravcomp="1">
      <joint name="probe_z" type="slide" axis="0 0 1" damping="0.001"/>
      <geom name="probe_geom" class="probe_sphere"/>
    </body>

    <body name="finger" pos="0 0 0.01" euler="0 -0.0355 0">
      <geom name="finger_tip_visual" type="mesh" mesh="gripper_end" material="metal" mass="0"
            contype="0" conaffinity="0"/>
      <body name="finger_pad" pos="0.00 0 0.00" >
        <geom name="finger_silicone_visual" type="mesh" mesh="silicone" mass="0"
              contype="0" conaffinity="0" group="1" material="silicone_vis"/>
        <geom name="finger_silicone" type="mesh" mesh="silicone_hull" mass="0.02" pos="0.0 0.0 -0.01" euler="0 -0.05 0"
              contype="2" conaffinity="2" group="3" material="silicone_vis" solref="0.002 1" solimp="0.99 0.999 0.0005"/>
        <site name="finger_tactile_site" pos="0.0372 0.014386 0.001563" xyaxes="0.00684 0.00009 0.999977 0 1 -0.00009" size="0.001" group="5"/>
      </body>
    </body>

  </worldbody>

  <sensor>
    <plugin name="finger_tactile" plugin="tip.tactile.universa" objtype="site" objname="finger_tactile_site">
      <config key="npoints" value="80"/>
      <config key="coords" value="-8.75 -11.25 -6.25 -11.25 -3.75 -11.25 -1.25 -11.25 1.25 -11.25 3.75 -11.25 6.25 -11.25 8.75 -11.25 -8.75 -8.75 -6.25 -8.75 -3.75 -8.75 -1.25 -8.75 1.25 -8.75 3.75 -8.75 6.25 -8.75 8.75 -8.75 -8.75 -6.25 -6.25 -6.25 -3.75 -6.25 -1.25 -6.25 1.25 -6.25 3.75 -6.25 6.25 -6.25 8.75 -6.25 -8.75 -3.75 -6.25 -3.75 -3.75 -3.75 -1.25 -3.75 1.25 -3.75 3.75 -3.75 6.25 -3.75 8.75 -3.75 -8.75 -1.25 -6.25 -1.25 -3.75 -1.25 -1.25 -1.25 1.25 -1.25 3.75 -1.25 6.25 -1.25 8.75 -1.25 -8.75 1.25 -6.25 1.25 -3.75 1.25 -1.25 1.25 1.25 1.25 3.75 1.25 6.25 1.25 8.75 1.25 -8.75 3.75 -6.25 3.75 -3.75 3.75 -1.25 3.75 1.25 3.75 3.75 3.75 6.25 3.75 8.75 3.75 -8.75 6.25 -6.25 6.25 -3.75 6.25 -1.25 6.25 1.25 6.25 3.75 6.25 6.25 6.25 8.75 6.25 -8.75 8.75 -6.25 8.75 -3.75 8.75 -1.25 8.75 1.25 8.75 3.75 8.75 6.25 8.75 8.75 8.75 -8.75 11.25 -6.25 11.25 -3.75 11.25 -1.25 11.25 1.25 11.25 3.75 11.25 6.25 11.25 8.75 11.25"/>
      <config key="full_scale" value="30"/>
      <config key="accuracy" value="1.0"/>
      <config key="repeatability" value="0.7"/>
      <config key="trigger_force" value="0.05"/>
      <config key="hysteresis_loop" value="0.5"/>
      <config key="hysteresis_asymmetry" value="1.2"/>
      <config key="seed" value="1"/>
    </plugin>
  </sensor>
</mujoco>
