    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <actuator>
    <general class="2f85" name="fingers_actuator" tendon="split" forcerange="-1 1" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
    <position name="lift_actuator" joint="lift_joint" ctrlrange="0 0.10" kp="800" kv="40" forcerange="-50 50"/>
